{
  "name": "xuehai-wiki",
  "type": "module",
  "version": "0.0.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "check": "astro check",
    "wiki:install": "npm --prefix wiki-app install",
    "wiki:build": "npm --prefix wiki-app run build",
    "wiki:dev": "npm --prefix wiki-app run dev"
  },
  "dependencies": {
    "astro": "^7.2.8"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.127.0"
  }
}