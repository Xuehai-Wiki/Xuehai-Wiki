---
// 顶部黄色免责 banner:只在 localStorage 'xh-disclaimer-seen' 为空时显示一次。
// 防闪由 BaseLayout 的 head 内联脚本处理(读 localStorage → 在 <html> 上加
// data-banner-hidden → CSS 隐藏),这里只负责渲染与点 X 关闭逻辑。
const TEXT = '此网站非学海官方网站,与学海教育及智通云亦不存在从属关系';
const KEY = 'xh-disclaimer-seen';
---

<div class="xh-banner" role="status" data-disclosure-banner>
	<span>{TEXT}</span>
	<button class="xh-banner-close" type="button" aria-label="关闭提示" data-disclosure-close>
		×
	</button>
</div>

<script>
	// 与 starlight-globals.js 共用同一 key,避免重复弹出。
	const KEY = 'xh-disclaimer-seen';
	const bar = document.querySelector('[data-disclosure-banner]');
	const close = document.querySelector('[data-disclosure-close]');

	close?.addEventListener('click', () => {
		try {
			localStorage.setItem(KEY, '1');
		} catch {
			/* 忽略 */
		}
		// 立即移除 + 给 <html> 加标记,双保险(后续刷新靠 CSS 先行隐藏)
		document.documentElement.setAttribute('data-banner-hidden', '');
		bar?.remove();
	});
</script>