---
// Starlight /docs 页面的顶栏 override:
// 与全站导航统一(品牌 Xuehai Wiki + 链接 + 主题切换),同时保留 Starlight 右侧
// 功能控件(搜索 + 主题选择)。移动端折叠菜单仍由 Starlight PageFrame 提供。
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import ThemeToggle from '../ThemeToggle.astro';

interface Props {
	currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const links = [
	{ href: '/', label: '首页' },
	{ href: '/status', label: 'Status' },
	{ href: '/tracker', label: 'Tracker' },
	{ href: '/docs', label: 'Docs' },
];

const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<a class="xh-nav-brand" href="/" aria-label="Xuehai Wiki 首页">
			<span>Xuehai Wiki</span>
			<small>学海 Wiki</small>
		</a>
	</div>

	<nav class="xh-nav-links sl-flex" aria-label="主导航">
		{
			links.map((link) => (
				<a
					class="xh-nav-link"
					href={link.href}
					aria-current={isActive(link.href) ? 'page' : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<div class="sl-flex print:hidden xh-starlight-right">
		<Search />
		<ThemeToggle />
		<ThemeSelect class="sl-hidden xh-theme-select" />
	</div>
</div>

<style>
	/* 让 docs 顶栏看起来与全站 Nav 一致,同时不破坏 Starlight 布局。 */
	.xh-nav-links {
		flex: 1;
		justify-content: center;
		gap: 0.25rem;
		margin-inline: 1rem;
		min-width: 0;
		overflow: clip;
	}
	.xh-starlight-right {
		gap: 0.75rem;
		align-items: center;
		margin-inline-start: auto;
	}
	/* 移动端:隐藏我们的主题按钮,保留 Starlight 自带的(它更适配窄屏) */
	@media (max-width: 50rem) {
		.xh-nav-links {
			display: none;
		}
	}
</style>