---
// 状态徽章:彩色点缀(黄→深绿→绿→黄→红,MIGHT→FIXED)。
// 文案映射 + 对应 CSS 类名(空格转连字符)。
interface Props {
	status: string;
}

const { status } = Astro.props;

const LABELS: Record<string, string> = {
	MIGHT: '可能有效',
	'PARTLY VALID': '部分有效',
	VALID: '有效',
	CHANGED: '已变更',
	FIXED: '已修复',
};

const cls = status.toLowerCase().replace(/ /g, '-');
const label = LABELS[status] ?? status;
---

<span class={`tracker-badge tracker-badge--${cls}`}>{label}</span>