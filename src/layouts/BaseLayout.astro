---
// 全站自定义页面布局:head(主题防 FOUC + 样式)+ 顶部免责 banner + nav + 内容 + footer。
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DisclosureBanner from '../components/DisclosureBanner.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Xuehai Wiki',
	description = '学海 Wiki — 社区维护的学海知识库',
} = Astro.props;

// 是否显示免责 banner:仅当 localStorage 'xh-disclaimer-seen' 为空时。
// 服务端无法读 localStorage,故始终渲染,由组件脚本在客户端判断移除。
const showBanner = true;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Umami 站点统计 -->
		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="b4795099-d45b-4b35-aa70-3270d7b71ee2"
		></script>
		<!-- 主题初始化:放 head 紧前,防 FOUC -->
		<script is:inline src="/theme-init.js"></script>
		<!-- 免责 banner 防闪:head 同步读 localStorage,已关闭则在 <html> 上加
		     data-banner-hidden,由 CSS 先行隐藏(.xh-banner display:none),避免首帧闪现 -->
		<script is:inline>
			try {
				if (localStorage.getItem('xh-disclaimer-seen')) {
					document.documentElement.setAttribute('data-banner-hidden', '');
				}
			} catch {
				/* 隐私模式等异常忽略 */
			}
		</script>
	</head>
	<body>
		<Nav currentPath={Astro.url.pathname} />
		{showBanner && <DisclosureBanner />}
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>