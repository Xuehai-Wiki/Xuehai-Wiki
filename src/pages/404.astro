---
// 自定义 404 页:大号 404 + 中文文案 + 返回首页按钮。黑白灰设计感。
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="404 | 页面不存在 — Xuehai Wiki"
	description="页面不存在"
>
	<section class="notfound">
		<div class="notfound-code" aria-hidden="true">404</div>
		<h1 style="margin: 1rem 0 0.25rem; font-size: 1.4rem;">页面不存在</h1>
		<p>
			你访问的页面可能已被移除、改名,或根本不曾存在。检查一下网址,或回到首页看看。
		</p>
		<a class="btn btn--primary" href="/">返回首页</a>
	</section>
</BaseLayout>