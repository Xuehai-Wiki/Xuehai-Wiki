---
// 应用索引页 /apps:按业务分类分组,每个应用链接到构建期生成的详情页。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { appsByCategory } from '../../lib/apps';

const categoryList = appsByCategory();
---

<BaseLayout
	title="学海应用 | Xuehai Wiki"
	description="按分类浏览学海的全部 Android 应用，查看最新版本信息并直接下载安装包。部分应用提供学生端 / 教师端两个版本，可在详情中区分。"
>
	<section class="container apps-hero">
		<h1>学海应用</h1>
		<p class="apps-hero-en">Xuehai Apps</p>
		<p class="apps-hero-desc">
			按分类浏览学海的全部 Android 应用，查看最新版本信息并直接下载安装包。部分应用提供学生端 / 教师端两个版本，可在详情中区分。
		</p>
	</section>

	<section class="container">
		<div class="tracker-toolbar" role="group" aria-label="按角色筛选">
			<span class="muted">角色</span>
			<button class="btn btn--sm btn--primary" type="button" data-role-filter="all" aria-pressed="true">全部</button>
			<button class="btn btn--sm" type="button" data-role-filter="student" aria-pressed="false">学生端</button>
			<button class="btn btn--sm" type="button" data-role-filter="teacher" aria-pressed="false">教师端</button>
			<button class="btn btn--sm" type="button" data-role-filter="common" aria-pressed="false">通用</button>
		</div>
	</section>

	<section class="container apps-sections">
		{
			categoryList.map(({ key, label, list }) => (
				<section data-app-category={key}>
					<h2 class="apps-section-title">{label}</h2>
					<div class="card-grid">
						{list.map((app) => (
							<a
								class="card app-card card--link"
								data-app
								data-role={app.role.cls}
								href={app.detailUrl}
							>
								<div class="app-card-head">
									<div class="app-icon">
										{app.iconOk ? (
											<img src={app.icon} alt="" loading="lazy" referrerpolicy="no-referrer" />
										) : (
											<span class="muted">{app.name.slice(0, 1)}</span>
										)}
									</div>
									<div class="app-titlewrap">
										<h3>{app.name}</h3>
										<small class:list={['role-tag', `role-tag--${app.role.cls}`]}>{app.role.label}</small>
									</div>
								</div>

								{app.description && <p class="muted">{app.description}</p>}

								<dl class="app-meta">
									<div><dt>最新版本</dt><dd class="mono">{app.latest?.versionLabel ?? '—'}</dd></div>
									<div><dt>大小</dt><dd>{app.sizeText || '—'}</dd></div>
									<div><dt>更新时间</dt><dd>{app.dateText || '—'}</dd></div>
									<div><dt>历史版本</dt><dd>{app.totalVersions} 个</dd></div>
								</dl>

								<div class="app-card-foot">
									<span class="btn btn--sm btn--primary app-card-cta">查看详情</span>
								</div>
							</a>
						))}
					</div>
				</section>
			))
		}
	</section>

	<div class="container tracker-empty" id="apps-empty" hidden>
		没有匹配的应用,请切换角色筛选。
	</div>

	<script is:inline data-astro-rerun>
		(() => {
			const filterButtons = Array.from(document.querySelectorAll('[data-role-filter]'));
			const apps = Array.from(document.querySelectorAll('[data-app]'));
			const emptyElement = document.getElementById('apps-empty');

			function apply() {
				const active = document.querySelector('[data-role-filter][aria-pressed="true"]');
				const role = active ? active.dataset.roleFilter : 'all';
				let visible = 0;
				apps.forEach((app) => {
					const match = role === 'all' || app.dataset.role === role;
					app.hidden = !match;
					if (match) visible++;
				});
				document.querySelectorAll('[data-app-category]').forEach((section) => {
					const shown = Array.from(section.querySelectorAll('[data-app]')).some((app) => !app.hidden);
					section.hidden = !shown;
				});
				if (emptyElement) emptyElement.hidden = visible !== 0;
			}

			filterButtons.forEach((button) => {
				button.addEventListener('click', () => {
					filterButtons.forEach((item) => {
						const selected = item === button;
						item.classList.toggle('btn--primary', selected);
						item.setAttribute('aria-pressed', String(selected));
					});
					apply();
				});
			});

			apply();
		})();
	</script>
</BaseLayout>
