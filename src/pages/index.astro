---
// 着陆页:站名大标题 + 副题 + 免责小字 + 与导航同序的五个入口。
import BaseLayout from '../layouts/BaseLayout.astro';

import { links } from '../components/SiteNav.astro';
---

<BaseLayout
	title="Xuehai Wiki | 学海 Wiki"
	description="学海 Wiki — 学海知识库,含应用列表、服务状态、特性追踪与文档。"
>
	<section class="container container--narrow" style="padding-block: 4rem 2rem; text-align: center;">
		<h1 style="margin-bottom: 0.75rem;">Xuehai Wiki</h1>
		<p class="muted" style="font-size: 1.05rem; margin: 0 auto; max-width: 30rem;">
			学海 Wiki — 一个学海知识库
		</p>
		<p class="faint" style="font-size: 0.8rem; margin-top: 1.25rem;">
			此网站非学海官方网站,与学海教育及智通云亦不存在从属关系
		</p>
	</section>

	<section class="container" style="padding-block: 1rem 3rem;">
		<div class="card-grid">
			{
				links.map((card) => (
					<a class="card card--link" href={card.href}>
						<h3>{card.label}</h3>
						<p>{card.description}</p>
						<span class="card-arrow">
							{card.caption}
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M5 12h14M12 5l7 7-7 7" />
							</svg>
						</span>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
