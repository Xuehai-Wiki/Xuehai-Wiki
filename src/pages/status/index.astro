---
// Xuehai Status 页:静态渲染外壳,客户端 fetch(60s 定时刷新)。
// 数据源:https://xh.asxz.one/status/api/v1/
// 结构:{ history_24h: {服务: [{time, status:0|1}]}, sla_60d: {服务: [{date, sla}]}, server_time }
// 图表用手写 SVG(零依赖),黑白灰,随亮暗主题用 CSS 变量描色。
import BaseLayout from '../../layouts/BaseLayout.astro';

const API = 'https://xh.asxz.one/status/api/v1/';
---

<BaseLayout
	title="Xuehai Status | 学海状态"
	description="学海服务实时状态、近 24 小时可用性与 60 天 SLA。"
>
	<section class="container status-hero">
		<h1 style="margin: 0;">Xuehai Status</h1>
		<p class="muted" style="margin: 0.4rem 0 0; font-size: 0.95rem;">
			学海服务状态监控
		</p>
	</section>

	<section class="container">
		<!-- 加载态 -->
		<div class="status-loading" data-status-loading>
			正在获取服务状态…
		</div>

		<!-- 错误态 -->
		<div class="status-error" data-status-error hidden>
			<p style="margin: 0 0 1rem;">无法获取状态数据,请稍后重试。</p>
			<button class="btn" type="button" data-status-retry>重试</button>
		</div>

		<!-- 内容态 -->
		<div data-status-content hidden>
			<!-- 当前状态汇总 -->
			<div class="status-summary" data-status-summary></div>

			<!-- 24h 时间线 -->
			<section class="status-block">
				<h2>
					近 24 小时
					<span class="status-meta" data-status-24h-meta></span>
				</h2>
				<div data-status-timeline></div>
			</section>

			<!-- SLA 格子图(标题天数动态,与格子数一致) -->
			<section class="status-block">
				<h2>
					<span data-status-sla-title>SLA</span>
					<span class="status-meta" data-status-sla-meta></span>
				</h2>
				<div data-status-sla></div>
			</section>

			<!-- 页脚元信息 -->
			<div class="status-footer-meta">
				<span data-status-server-time></span>
				<span>每 60 秒自动刷新</span>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	import type { StatusData } from '../types/status';

	const API = 'https://xh.asxz.one/status/api/v1/';
	// 服务列表以 API 返回为准(union of history/sla),新增服务自动展示,无需改代码

	const loadingEl = document.querySelector('[data-status-loading]');
	const errorEl = document.querySelector('[data-status-error]');
	const contentEl = document.querySelector('[data-status-content]');
	const summaryEl = document.querySelector('[data-status-summary]');
	const timelineEl = document.querySelector('[data-status-timeline]');
	const slaEl = document.querySelector('[data-status-sla]');
	const slaTitleEl = document.querySelector('[data-status-sla-title]');
	const slaMetaEl = document.querySelector('[data-status-sla-meta]');
	const meta24hEl = document.querySelector('[data-status-24h-meta]');
	const serverTimeEl = document.querySelector('[data-status-server-time]');
	const retryBtn = document.querySelector('[data-status-retry]');

	// ---------- 降采样:把长序列压到 ≤max 个点 ----------
	function downsample<T>(arr: T[], max: number): T[] {
		if (arr.length <= max) return arr;
		const step = arr.length / max;
		const out: T[] = [];
		for (let i = 0; i < max; i++) {
			out.push(arr[Math.floor(i * step)]);
		}
		return out;
	}

	// ---------- 24h 时间线 SVG ----------
	function renderTimeline(history: Record<string, { time: string; status: number }[]>, services: string[]) {
		const W = 800;
		const H = 44;
		const PAD = 6;
		const MAX = 120;
		let html = '';
		for (const name of services) {
			const pts = downsample(history[name] ?? [], MAX);
			if (!pts.length) continue;
			const n = pts.length;
			const bw = (W - PAD * 2) / n;
			const upCount = pts.filter((p) => p.status === 1).length;
			const uptime = (upCount / n) * 100;
			let bars = '';
			for (let i = 0; i < n; i++) {
				const x = PAD + i * bw;
				const up = pts[i].status === 1;
				const fill = up ? 'var(--ok)' : 'var(--danger)';
				bars += `<rect x="${x.toFixed(2)}" y="2" width="${Math.max(bw - 1, 1).toFixed(2)}" height="${H - 4}" fill="${fill}" rx="1"/>`;
			}
			html += `
				<div class="timeline-row">
					<div class="timeline-row-label">
						<span class="name">${name}</span>
						<span class="uptime">24h 可用 ${uptime.toFixed(2)}%</span>
					</div>
					<svg class="timeline-chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="${name} 近24小时可用性">
						<rect x="0" y="0" width="${W}" height="${H}" fill="var(--bg-soft)" rx="6"/>
						${bars}
					</svg>
				</div>`;
		}
		return html;
	}

	// ---------- SLA:一天一格(GitHub 贡献图风格,方块) ----------
	function renderSla(sla: Record<string, { date: string; sla: number }[]>, services: string[]) {
		const CELL_W = 12;
		const CELL_H = 12;
		const GAP = 3;
		const LABEL_W = 132;
		const PAD = 4;
		const ROW_H = 28;
		const maxCells = Math.max(
			0,
			...services.map((n) => (sla[n] ?? []).length)
		);
		const cellsW = Math.max(maxCells * (CELL_W + GAP) - GAP, 0);
		const W = LABEL_W + cellsW + PAD * 2;
		let html = '';
		let y = PAD;
		for (const name of services) {
			const rows = sla[name] ?? [];
			const avg = rows.length
				? rows.reduce((s, r) => s + r.sla, 0) / rows.length
				: 0;
			let cells = '';
			rows.forEach((r, i) => {
				// 只有真实 100% 才绿色;未达 100 一律血红色(醒目),不再用灰
				const color = r.sla >= 99.9995 ? 'var(--ok)' : 'var(--danger)';
				const x = LABEL_W + PAD + i * (CELL_W + GAP);
				cells += `<rect x="${x}" y="${ROW_H / 2 - CELL_H / 2 + 1}" width="${CELL_W}" height="${CELL_H}" rx="2" fill="${color}"><title>${name} ${r.date} SLA ${r.sla.toFixed(2)}%</title></rect>`;
			});
			html += `
				<g transform="translate(0 ${y})">
					<text x="0" y="16" font-size="12" fill="var(--fg)">${name}<tspan fill="var(--fg-muted)" font-size="11"> ${avg.toFixed(3)}%</tspan></text>
					${cells}
				</g>`;
			y += ROW_H;
		}
		const H = y + PAD;
		return `
			<div class="sla-chart-wrap">
				<svg class="sla-chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="60天SLA">
					${html}
				</svg>
			</div>`;
	}

	// ---------- 汇总卡片 ----------
	function renderSummary(history: Record<string, { status: number }[]>, services: string[]) {
		let html = '';
		for (const name of services) {
			const pts = history[name] ?? [];
			const last = pts[pts.length - 1];
			const up = last ? last.status === 1 : false;
			const upCount = pts.filter((p) => p.status === 1).length;
			const uptime = pts.length ? (upCount / pts.length) * 100 : 0;
			html += StatusCardHtml(name, up, uptime);
		}
		return html;
	}

	function StatusCardHtml(name: string, up: boolean, uptime24h: number) {
		return `
			<div class="status-item">
				<div>
					<div class="status-item-name">${name}</div>
					<div class="status-item-sub">24h 可用 ${uptime24h.toFixed(2)}%</div>
				</div>
				<span class="badge ${up ? 'badge--on' : 'badge--off'}">${up ? '正常' : '异常'}</span>
			</div>`;
	}

	// ---------- 状态切换 ----------
	function setLoading() {
		loadingEl?.removeAttribute('hidden');
		errorEl?.setAttribute('hidden', '');
		contentEl?.setAttribute('hidden', '');
	}

	function setError() {
		loadingEl?.setAttribute('hidden', '');
		errorEl?.removeAttribute('hidden');
		contentEl?.setAttribute('hidden', '');
	}

	function setContent(data: StatusData) {
		loadingEl?.setAttribute('hidden', '');
		errorEl?.setAttribute('hidden', '');
		contentEl?.removeAttribute('hidden');

		// 服务列表以 API 返回为准:先 history 后 sla,去重保序。新增服务自动出现,不用改代码。
		const services = Array.from(
			new Set([...Object.keys(data.history_24h), ...Object.keys(data.sla_60d)])
		);

		if (summaryEl) summaryEl.innerHTML = renderSummary(data.history_24h, services);
		if (timelineEl) timelineEl.innerHTML = renderTimeline(data.history_24h, services);
		if (slaEl) slaEl.innerHTML = renderSla(data.sla_60d, services);

		// SLA 标题天数动态化,与实际格子数一致
		const slaDays = Math.max(
			0,
			...services.map((n) => (data.sla_60d[n] ?? []).length)
		);
		if (slaTitleEl) slaTitleEl.textContent = `${slaDays} 天 SLA`;
		if (slaMetaEl) {
			const first = data.sla_60d[services[0]]?.[0]?.date;
			const last = data.sla_60d[services[0]]?.at(-1)?.date;
			if (first && last) slaMetaEl.textContent = `${first} — ${last}`;
		}

		if (meta24hEl) {
			const first = data.history_24h[services[0]]?.[0]?.time;
			const last = data.history_24h[services[0]]?.at(-1)?.time;
			if (first && last) meta24hEl.textContent = `${first.slice(5, 16)} — ${last.slice(5, 16)}`;
		}
		if (serverTimeEl && data.server_time) {
			serverTimeEl.textContent = `服务器时间 ${data.server_time}`;
		}
	}

	// ---------- 拉取 ----------
	async function load() {
		setLoading();
		try {
			const res = await fetch(API);
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const data: StatusData = await res.json();
			setContent(data);
		} catch {
			setError();
		}
	}

	retryBtn?.addEventListener('click', load);
	load();
	setInterval(load, 60_000);
</script>