---
// 学海特性(bug)追踪列表页 /tracker
// 筛选 / 搜索 / 分页 / 随机抽卡全部在客户端 JS 完成(数据构建期内嵌)。
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrackerTable from '@/components/tracker/TrackerTable.astro';
import RandomCard from '@/components/tracker/RandomCard.astro';
import PaginationBar from '@/components/tracker/PaginationBar.astro';
import { canonicalXhpeId } from '@/components/tracker/xhpe';

const all = await getCollection('tracker');

// 内嵌给客户端 JS 的数据:随机抽卡用(id/type/status/xhcs/title)
// id 归一化为大写规范形 XHPE-1001(glob loader 会把文件名小写化)
const cardData = all.map((e) => ({
	id: canonicalXhpeId(e.id),
	type: e.data.type,
	status: e.data.status,
	xhcs: e.data.xhcs,
	title: e.data.title,
}));
// 转义 < 防止内容里出现 </script> 提前闭合
const cardJson = JSON.stringify(cardData).replace(/</g, '\\u003c');

const ADD_URL = 'https://github.com/Xuehai-Wiki/Xuehai-Wiki/issues/new/choose';

// 筛选面板选项(状态/类型),供服务端渲染复选框。
const STATUS_OPTIONS = [
	{ value: 'MIGHT', label: '可能有效' },
	{ value: 'PARTLY VALID', label: '部分有效' },
	{ value: 'VALID', label: '有效' },
	{ value: 'CHANGED', label: '已变更' },
	{ value: 'FIXED', label: '已修复' },
];
const TYPE_OPTIONS = [
	{ value: 'Feature', label: '特性' },
	{ value: 'Bug', label: 'Bug' },
];
---

<BaseLayout title="学海特性(bug)追踪" description="记录学海的奇奇怪怪的特性/bug —— 学海特性(bug)追踪器">
	<div class="container">
		<!-- intro 区 -->
		<section class="tracker-intro">
			<div>
				<h1 class="tracker-title">学海特性(bug)追踪</h1>
				<p class="tracker-subtitle">Xuehai Feature (Bug) Tracker</p>
				<p class="tracker-disclaimer">
					记录学海奇奇怪怪的特性/bug
					<br>
					此追踪器非学海官方漏洞报告站点,与学海教育及智通云亦不存在从属关系。
				</p>
			</div>
			<RandomCard />
		</section>

		<!-- 工具栏 -->
		<div class="tracker-toolbar">
			<input
				id="tracker-search"
				class="tracker-search"
				type="search"
				placeholder="搜索编号 / 标题 / 描述 / 应用 / 版本 / 提交者…"
				autocomplete="off"
				spellcheck="false"
			/>

			<!-- 筛选面板:状态 + 类型 多选,点"筛选"展开 -->
			<div class="tracker-filter" id="tracker-filter">
				<button
					type="button"
					class="tracker-filter-toggle"
					id="tracker-filter-toggle"
					aria-expanded="false"
					aria-haspopup="true"
					aria-controls="tracker-filter-panel"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M4 6h16M7 12h10M10 18h4" />
					</svg>
					筛选
					<span class="tracker-filter-count" id="tracker-filter-count" hidden>0</span>
				</button>

				<div class="tracker-filter-panel" id="tracker-filter-panel" hidden>
					<div class="tracker-filter-group">
						<span class="tracker-filter-label">状态</span>
						<div class="tracker-filter-options">
							{
								STATUS_OPTIONS.map((o) => (
									<label class="tracker-filter-option">
										<input type="checkbox" value={o.value} data-filter="status" />
										<span>{o.label}</span>
									</label>
								))
							}
						</div>
					</div>
					<div class="tracker-filter-group">
						<span class="tracker-filter-label">类型</span>
						<div class="tracker-filter-options">
							{
								TYPE_OPTIONS.map((o) => (
									<label class="tracker-filter-option">
										<input type="checkbox" value={o.value} data-filter="type" />
										<span>{o.label}</span>
									</label>
								))
							}
						</div>
					</div>
					<div class="tracker-filter-actions">
						<button type="button" class="tracker-filter-clear" id="tracker-filter-clear">
							清空筛选
						</button>
					</div>
				</div>
			</div>

			<span class="spacer"></span>
			<a
				class="tracker-add"
				href={ADD_URL}
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.4"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M12 5v14M5 12h14" />
				</svg>
				Add New Feature
			</a>
		</div>

		<!-- 结果信息 + 空态 -->
		<p id="tracker-pageinfo" class="tracker-pageinfo"></p>

		<!-- 列表 -->
		<TrackerTable entries={all} perPage={20} />

		<div id="tracker-empty" class="tracker-empty" hidden>
			没有匹配的记录,换个关键词或筛选条件试试。
		</div>

		<!-- 分页 -->
		<PaginationBar />
	</div>

	<!-- 随机抽卡数据(客户端 JS 读取) -->
	<script type="application/json" id="tracker-data" set:html={cardJson}></script>

	<!-- 客户端交互:随机抽卡 / 筛选 / 搜索 / 分页 -->
	<script is:inline>
		(() => {
			const dataEl = document.getElementById('tracker-data');
			if (!dataEl) return;
			let items = [];
			try {
				items = JSON.parse(dataEl.textContent);
			} catch {
				items = [];
			}

			const PER = 20;
			const rows = Array.from(document.querySelectorAll('.tracker-row'));
			const searchInput = document.getElementById('tracker-search');
			const pagNav = document.getElementById('tracker-pagination');
			const pageInfo = document.getElementById('tracker-pageinfo');
			const emptyEl = document.getElementById('tracker-empty');

			// ---- 筛选面板(状态 + 类型 多选) ----
			const filterToggle = document.getElementById('tracker-filter-toggle');
			const filterPanel = document.getElementById('tracker-filter-panel');
			const filterCount = document.getElementById('tracker-filter-count');
			const filterClear = document.getElementById('tracker-filter-clear');
			const filterBoxes = Array.from(
				document.querySelectorAll('#tracker-filter-panel input[type="checkbox"]'),
			);
			// 选中集合:status / type
			const sel = { status: new Set(), type: new Set() };

			function currentCount() {
				return sel.status.size + sel.type.size;
			}

			function syncCount() {
				if (!filterCount) return;
				const n = currentCount();
				filterCount.hidden = n === 0;
				filterCount.textContent = String(n);
			}

			filterToggle?.addEventListener('click', () => {
				const open = filterPanel.hidden;
				filterPanel.hidden = !open;
				filterToggle.setAttribute('aria-expanded', String(!open));
			});

			filterClear?.addEventListener('click', () => {
				filterBoxes.forEach((b) => {
					b.checked = false;
				});
				sel.status.clear();
				sel.type.clear();
				syncCount();
				apply();
			});

			filterBoxes.forEach((box) => {
				box.addEventListener('change', () => {
					const kind = box.dataset.filter;
					const v = box.value;
					if (box.checked) sel[kind].add(v);
					else sel[kind].delete(v);
					syncCount();
					apply();
				});
			});

			let page = 1;
			let filtered = rows;

			function apply() {
				const q = (searchInput?.value || '').trim().toLowerCase();
				filtered = rows.filter((r) => {
					if (sel.status.size && !sel.status.has(r.dataset.status)) return false;
					if (sel.type.size && !sel.type.has(r.dataset.type)) return false;
					if (q && !(r.dataset.search || '').includes(q)) return false;
					return true;
				});
				page = 1; // 筛选改变重置到第 1 页
				render();
			}

			function render() {
				const total = filtered.length;
				const pages = Math.max(1, Math.ceil(total / PER));
				if (page > pages) page = pages;

				const start = (page - 1) * PER;
				const end = start + PER;
				rows.forEach((r) => {
					r.hidden = true;
				});
				filtered.slice(start, end).forEach((r) => {
					r.hidden = false;
				});

				if (pageInfo) pageInfo.textContent = `第 ${page} / ${pages} 页 · 共 ${total} 条`;
				if (emptyEl) emptyEl.hidden = total !== 0;
				buildPagination(pages);
			}

			function buildPagination(pages) {
				if (!pagNav) return;
				pagNav.innerHTML = '';
				const mk = (label, p, disabled, active) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.textContent = label;
					b.className = 'tracker-page';
					if (active) b.classList.add('is-active');
					if (disabled) b.disabled = true;
					b.addEventListener('click', () => {
						page = p;
						render();
					});
					return b;
				};
				pagNav.appendChild(mk('上一页', page - 1, page <= 1, false));
				const startP = Math.max(1, page - 2);
				const endP = Math.min(pages, page + 2);
				for (let p = startP; p <= endP; p++) {
					pagNav.appendChild(mk(String(p), p, false, p === page));
				}
				pagNav.appendChild(mk('下一页', page + 1, page >= pages, false));
			}

			// 随机抽卡:每次刷新随机一条
			function renderRandom() {
				const box = document.getElementById('tracker-random-box');
				if (!box || !items.length) return;
				const e = items[Math.floor(Math.random() * items.length)];
				const statusLabel = {
					MIGHT: '可能有效',
					'PARTLY VALID': '部分有效',
					VALID: '有效',
					CHANGED: '已变更',
					FIXED: '已修复',
				}[e.status] || e.status;
				const typeLabel = e.type === 'Bug' ? 'Bug' : '特性';
				const typeCls = e.type === 'Bug' ? 'bug' : 'feature';
				const statusCls = e.status.toLowerCase().replace(/ /g, '-');
				box.innerHTML = `
					<a class="tracker-random-card" href="/tracker/${e.id}">
						<span class="tracker-random-id">${e.id}</span>
						<span class="tracker-random-title">${e.title}</span>
						<span class="tracker-random-meta">
							<span class="tracker-badge tracker-badge--${typeCls}">${typeLabel}</span>
							<span class="tracker-badge tracker-badge--${statusCls}">${statusLabel}</span>
							<span class="tracker-xhcs">XHCS ${e.xhcs}</span>
						</span>
					</a>`;
			}

			// 整行可点击跳详情(点击内部链接时交给链接自身)
			rows.forEach((r) => {
				r.addEventListener('click', (ev) => {
					if (ev.target.closest('a')) return;
					const href = r.dataset.href;
					if (href) window.location.href = href;
				});
			});

			searchInput?.addEventListener('input', apply);

			// 点击面板外部时收起
			document.addEventListener('click', (ev) => {
				if (!filterPanel || filterPanel.hidden) return;
				const wrap = document.getElementById('tracker-filter');
				if (wrap && !wrap.contains(ev.target)) {
					filterPanel.hidden = true;
					filterToggle?.setAttribute('aria-expanded', 'false');
				}
			});

			syncCount();
			render();
			renderRandom();
		})();
	</script>
</BaseLayout>