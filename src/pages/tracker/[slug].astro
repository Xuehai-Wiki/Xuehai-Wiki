---
// 学海特性(bug)追踪详情页 /tracker/XHPE-XXXX
// 硬校验:slug 必须匹配 /^XHPE-\d+$/ 且编号 ≥ 1001,否则构建期 throw(数据库纪律)。
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGitLastModified, formatDateTime } from '@/utils/gitlog';
import { features } from '@/lib/features';
import StatusBadge from '@/components/tracker/StatusBadge.astro';
import TypeBadge from '@/components/tracker/TypeBadge.astro';
import { canonicalXhpeId } from '@/components/tracker/xhpe';

export async function getStaticPaths() {
	const entries = await getCollection('tracker');
	return entries.map((entry) => {
		// 硬校验 + 归一化为大写规范形 XHPE-1001(glob loader 会把文件名小写化)
		const slug = canonicalXhpeId(entry.id);
		return { params: { slug }, props: { entry } };
	});
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 展示用的大写规范形编号(URL 与页面标题);文件路径仍用 entry.id(小写)
const canonicalId = canonicalXhpeId(entry.id);

// 最后修改:无 git 历史时返回 null,隐藏该项
const modified = getGitLastModified('src/content/tracker/' + entry.id + '.md');
const modifiedStr = modified ? formatDateTime(modified) : null;

const likesEnabled = features.likes.enabled;
const likesWorkerUrl = features.likes.workerUrl;
const commentsEnabled = features.comments.enabled;
const twikooEnvId = features.comments.twikooEnvId;

// 内嵌给客户端 JS 的配置(用 set:html 注入,避免脚本内 {} 表达式被 Astro 解析)
const detailCfg = JSON.stringify({
	likesEnabled,
	likesWorkerUrl,
}).replace(/</g, '\\u003c');

// Twikoo 初始化脚本(默认关闭不渲染;enabled 时才注入;等 #tcomment 与 twikoo 库就绪后 init)
const twikooInitScript = `(function () {
  function init() {
    var el = document.getElementById('tcomment');
    if (!el || typeof twikoo === 'undefined') return;
    twikoo.init({
      envId: ${JSON.stringify(twikooEnvId)},
      el: '#tcomment',
      path: location.pathname,
    });
  }
  var tries = 0;
  var timer = setInterval(function () {
    tries++;
    var el = document.getElementById('tcomment');
    if (el && typeof twikoo !== 'undefined') {
      clearInterval(timer);
      init();
    } else if (tries > 100) {
      clearInterval(timer); // 10s 超时,静默放弃
    }
  }, 100);
})();`;
---

<BaseLayout
	title={`${canonicalId} · ${entry.data.title}`}
	description={`${entry.data.title} —— 学海特性(bug)追踪`}
>
	<div class="container">
		<!-- 面包屑 -->
		<nav class="tracker-breadcrumb" aria-label="面包屑">
			<a href="/tracker">← 返回列表</a>
		</nav>

		<!-- 标题区 -->
		<header class="tracker-detail-head">
			<span class="tracker-detail-id">{canonicalId}</span>
			<h1 class="tracker-detail-title">{entry.data.title}</h1>
			<div class="tracker-detail-badges">
				<TypeBadge type={entry.data.type} />
				<StatusBadge status={entry.data.status} />
			</div>
		</header>

		<!-- 字段表 -->
		<table class="tracker-fields">
			<tbody>
				<tr>
					<th>APP Name</th>
					<td>{entry.data.appName}</td>
				</tr>
				<tr>
					<th>APP Version</th>
					<td class="mono">{entry.data.appVersion}</td>
				</tr>
				<tr>
					<th>XHCS</th>
					<td class="mono">{entry.data.xhcs} / 5</td>
				</tr>
				<tr>
					<th>Reporter</th>
					<td>
						{entry.data.reporter ? (
							entry.data.reporter
						) : (
							<span class="tracker-anon">匿名</span>
						)}
					</td>
				</tr>
				{
					modifiedStr && (
						<tr>
							<th>最后修改</th>
							<td class="mono">{modifiedStr}</td>
						</tr>
					)
				}
			</tbody>
		</table>

		<!-- 描述正文 -->
		<article class="tracker-desc">
			<Content />
		</article>

		<!-- 底部功能位:点赞(默认关闭) + 评论(默认关闭) -->
		<footer class="tracker-foot">
			<button
				class="tracker-like"
				type="button"
				data-id={canonicalId}
				disabled
				aria-label="点赞(尚未开放)"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M7 10v12M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"
					/>
				</svg>
				<span>赞</span>
				<span class="tracker-like-count">0</span>
				<span class="tracker-like-todo">(TODO)</span>
			</button>
			<span class="tracker-like-note">
				点赞功能暂未开放,敬请期待。
			</span>
		</footer>

		{
			/* 评论(Twikoo):enabled 时渲染并加载外部脚本 */
			commentsEnabled && (
				<div class="tracker-comments">
					<div id="tcomment"></div>
					<script is:inline src="https://cdn.jsdelivr.net/npm/twikoo@1.7.20/dist/twikoo.min.js"></script>
					<script is:inline set:html={twikooInitScript}></script>
				</div>
			)
		}
	</div>

	<!-- 详情页客户端配置(点赞开关与 workerUrl) -->
	<script type="application/json" id="tracker-detail-cfg" set:html={detailCfg}></script>

	<!-- 点赞交互:开关默认关闭,按钮为禁用占位;enabled 时才请求 workerUrl -->
	<script is:inline>
		(() => {
			const cfgEl = document.getElementById('tracker-detail-cfg');
			let cfg = { likesEnabled: false, likesWorkerUrl: '' };
			if (cfgEl) {
				try {
					cfg = JSON.parse(cfgEl.textContent) || cfg;
				} catch {
					/* ignore */
				}
			}
			const btn = document.querySelector('.tracker-like');
			if (!btn) return;
			if (!cfg.likesEnabled) return; // 默认关闭:保留禁用占位,不发起任何请求
			if (!cfg.likesWorkerUrl) {
				// 已开启但未配置 workerUrl:错误态
				btn.classList.add('is-error');
				btn.disabled = true;
				btn.setAttribute('aria-label', '点赞服务未配置');
				return;
			}
			btn.disabled = false;
			btn.addEventListener('click', async () => {
				const id = btn.dataset.id;
				try {
					const res = await fetch(cfg.likesWorkerUrl, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id }),
					});
					if (!res.ok) throw new Error('bad status');
					const data = await res.json();
					const count = typeof data.count === 'number' ? data.count : 0;
					const c = btn.querySelector('.tracker-like-count');
					if (c) c.textContent = String(count);
				} catch (e) {
					btn.classList.add('is-error');
				}
			});
		})();
	</script>
</BaseLayout>